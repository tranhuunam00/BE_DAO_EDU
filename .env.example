# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
PORT=5005
JWT_SECRET=your_jwt_secret_key_here
APP_VERSION=v1.0.4

# =============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# =============================================================================
# Sử dụng 'localhost' nếu Backend và Postgres cùng chạy chung 1 server/máy local.
# Nhập IP của server nếu Database chạy trên server riêng biệt.
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=dao_edu_db_admin
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_NAME=dao_edu_db

# =============================================================================
# STORAGE CONFIGURATION (MINIO / S3)
# =============================================================================
# Sử dụng 'localhost' nếu Backend và MinIO cùng chạy chung 1 server/máy local.
# Nhập IP của server nếu MinIO chạy trên server riêng biệt.
MINIO_ENDPOINT=localhost
MINIO_PORT=9005
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dao_minio_root
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET_NAME=edu

# =============================================================================
# VIETQR - MANUAL BANK TRANSFER REQUESTS
# =============================================================================
# Bank code/BIN supported by VietQR, for example: MB, VCB, BIDV
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

# Credentials provided by DAO EDU to VietQR for callback authentication.
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_JWT_SECRET=

# Local/UAT only. Never enable this in production.
VIETQR_DEMO_ENABLED=false

# =============================================================================
# TIMEKEEPING TERMINAL CONFIGURATION
# =============================================================================
TIMEKEEPING_DEVICE_IP=192.168.22.123
TIMEKEEPING_DEVICE_PORT=80
TIMEKEEPING_DEVICE_USERNAME=admin
TIMEKEEPING_DEVICE_PASSWORD=your_device_password_here

# =============================================================================
# AI EVALUATION CONFIGURATION (GEMINI LLM & MODULE 09)
# =============================================================================
# Google Gemini API Key (từ Google AI Studio). Nếu để trống, hệ thống sẽ tự động dùng Fallback Template sư phạm
GEMINI_API_KEY=
# Model Gemini (Mặc định: gemini-flash-latest, có thể đổi thành gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-flash-latest
# Giới hạn số lượt gọi AI tối đa trong 1 phút của mỗi giáo viên (Mặc định: 30)
LLM_RATE_LIMIT_PER_MINUTE=30
# Thời gian chờ giữa 2 lần sinh AI cho cùng 1 học sinh tính theo giây (Mặc định: 3)
LLM_COOLDOWN_SECONDS=3

